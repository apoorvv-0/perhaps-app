generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum GlobalRole {
  USER
  SUPER_ADMIN
}

enum EventRoleType {
  ADMIN
  CASHIER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum Gender {
  MALE
  FEMALE
}

enum EventPhase {
  DRAFT
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  CHOOSING_OPEN
  CHOOSING_CLOSED
  MATCHING
  RESULTS_OPEN
  CLOSED
  ARCHIVED
}

enum CouponStatus {
  ISSUED
  REDEEMED
  VOIDED
}

// -----------------------------------------------------------------------------
// LOCAL IDENTITY (Synced from Roviara Hub)
// -----------------------------------------------------------------------------

model User {
  id              String     @id @default(uuid())
  roviaraId       String     @unique // Links to Roviara Hub User ID
  firstName       String
  lastName        String
  instagramHandle String?
  gender          Gender
  college         String
  batch           String
  
  globalRole      GlobalRole @default(USER)
  status          UserStatus @default(ACTIVE)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  pickerChoices      Choice[]           @relation("PickerChoices")
  pickedChoices      Choice[]           @relation("PickedChoices")
  matchesAsUser1     Match[]            @relation("MatchUser1")
  matchesAsUser2     Match[]            @relation("MatchUser2")
  couponsIssued      Coupon[]           @relation("CashierCoupons")
  auditLogsAsAdmin   AuditLog[]         @relation("AdminAuditLogs")
  matchingExecs      MatchingExecution[]
  leaderboardEntries LeaderboardEntry[]
  eventRegistrations EventRegistration[]
  eventRoles         EventRole[]

  // Perhaps Compatible additions
  anonymousLikesSent     AnonymousLike[] @relation("Liker")
  anonymousLikesReceived AnonymousLike[] @relation("Liked")
  compatibilityAnswers   CompatibilityAnswer[]

  @@index([status])
}

// -----------------------------------------------------------------------------
// PERHAPS MUTUAL (Event Matching)
// -----------------------------------------------------------------------------

model Event {
  id                   String     @id @default(uuid())
  slug                 String     @unique
  name                 String
  status               EventPhase @default(DRAFT)
  registrationStartAt  DateTime?
  registrationEndAt    DateTime?
  choosingStartAt      DateTime?
  choosingEndAt        DateTime?
  resultsStartAt       DateTime?
  resultsEndAt         DateTime?
  minimumParticipants  Int        @default(200)
  minimumPerGender     Int        @default(70)
  cancelledAt          DateTime?
  cancelReason         String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  colleges String @default("[]") 
  batches  String @default("[]") 

  choices              Choice[]
  matches              Match[]
  matchingExecutions   MatchingExecution[]
  leaderboardEntries   LeaderboardEntry[]
  phaseOverrides       PhaseOverride[]
  registrations        EventRegistration[]
  eventRoles           EventRole[]

  @@index([status])
  @@index([slug])
}

model EventRole {
  id        String        @id @default(uuid())
  eventId   String
  event     Event         @relation(fields: [eventId], references: [id])
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  role      EventRoleType
  createdAt DateTime      @default(now())

  @@unique([eventId, userId, role])
  @@index([userId])
}

model EventRegistration {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  minChoiceExempt Boolean @default(false)
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([eventId])
}

model PhaseOverride {
  id          String   @id @default(uuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id])
  adminId     String
  fromPhase   EventPhase
  toPhase     EventPhase
  reason      String
  timestamp   DateTime @default(now())

  @@index([eventId])
}

model Choice {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id])
  pickerId  String
  picker    User     @relation("PickerChoices", fields: [pickerId], references: [id])
  pickedId  String
  picked    User     @relation("PickedChoices", fields: [pickedId], references: [id])
  rank      Int      
  createdAt DateTime @default(now())

  @@unique([eventId, pickerId, pickedId])
  @@unique([eventId, pickerId, rank])
  @@index([eventId, pickerId])
  @@index([eventId, pickedId])
}

model MatchingExecution {
  id             String   @id @default(uuid())
  eventId        String
  event          Event    @relation(fields: [eventId], references: [id])
  version        Int
  executedById   String
  executedBy     User     @relation(fields: [executedById], references: [id])
  matchedCount   Int
  unmatchedCount Int
  totalPairs     Int
  isDryRun       Boolean  @default(false)
  timestamp      DateTime @default(now())

  @@unique([eventId, version])
  @@index([eventId])
}

model Match {
  id            String   @id @default(uuid())
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id])
  user1Id       String   
  user1         User     @relation("MatchUser1", fields: [user1Id], references: [id])
  user2Id       String
  user2         User     @relation("MatchUser2", fields: [user2Id], references: [id])
  matchStrength Int      
  createdAt     DateTime @default(now())
  revealed1     Boolean  @default(false) 
  revealed2     Boolean  @default(false) 

  @@unique([eventId, user1Id, user2Id])
  @@index([eventId])
  @@index([eventId, user1Id])
  @@index([eventId, user2Id])
}

model LeaderboardEntry {
  id          String   @id @default(uuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  gender      Gender
  college     String
  batch       String
  pickerCount Int      
  rank        Int      
  slice       String   
  computedAt  DateTime @default(now())

  @@unique([eventId, userId, slice])
  @@index([eventId, slice, gender, rank])
}

// -----------------------------------------------------------------------------
// PERHAPS COMPATIBLE (Personality Matching)
// -----------------------------------------------------------------------------

model CompatibilityQuestion {
  id          String   @id @default(uuid())
  question    String
  category    String   // e.g. "Lifestyle", "Values"
  options     Json     // Array of possible answers
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  
  answers     CompatibilityAnswer[]
}

model CompatibilityAnswer {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  questionId  String
  question    CompatibilityQuestion @relation(fields: [questionId], references: [id])
  answerValue String
  importance  Int      // 1-5 scale of how important this is in a partner
  createdAt   DateTime @default(now())

  @@unique([userId, questionId])
}

model AnonymousLike {
  id          String   @id @default(uuid())
  likerId     String
  liker       User     @relation("Liker", fields: [likerId], references: [id])
  likedId     String
  liked       User     @relation("Liked", fields: [likedId], references: [id])
  createdAt   DateTime @default(now())
  revealed    Boolean  @default(false) // Whether liked user paid to reveal instagram

  @@unique([likerId, likedId])
}

// -----------------------------------------------------------------------------
// COUPONS & SYSTEM
// -----------------------------------------------------------------------------

model Coupon {
  id         String       @id // 8-char alphanumeric code
  eventId    String?      // Which event this coupon was issued for
  faceValue  Int          // in paise (199 = 19900)
  status     CouponStatus @default(ISSUED)
  buyerPhone String
  cashierId  String
  cashier    User         @relation("CashierCoupons", fields: [cashierId], references: [id])
  issuedAt   DateTime     @default(now())
  redeemedAt DateTime?
  redeemedBy String?      // userId who redeemed
  voidedAt   DateTime?
  voidReason String?

  @@index([eventId])
  @@index([cashierId])
  @@index([buyerPhone])
  @@index([status])
}

model AuditLog {
  id           String   @id @default(uuid())
  adminId      String
  admin        User     @relation("AdminAuditLogs", fields: [adminId], references: [id])
  action       String   
  targetUserId String?  
  eventId      String?
  reason       String?
  metadata     Json?    
  timestamp    DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([targetUserId])
  @@index([timestamp])
}
